# Root of the catnip-data tree
# Overrides paths.data in config/pipeline.yaml. 
# All other paths in that file are interpolated from this root

# Dev machine (macOS, external SSD)
CATNIP_DATA=/Volumes/rifuSSD/catnip-data

# Dev machine (default, relative to repo root)
# CATNIP_DATA=catnip-data

# Lightning AI Studio (data pulled from R2 to Studio home)
# CATNIP_DATA=$HOME/catnip-data

# Google Colab fallback (tarball pulled from R2 via boto3 — see notebooks/catnipColab.ipynb)
# CATNIP_DATA=/content/catnip-data-local

# Kaggle notebook (read-only mount of the catnip-stage1-sliced dataset)
# CATNIP_DATA=/kaggle/input/catnip-stage1-sliced

# Inference server
# CATNIP_DATA=/srv/catnip-data

# Cloudflare R2 (canonical archive) — S3 API credentials for bulk ops
# (s5cmd/boto3/wrangler). Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Kaggle API token
# For the notebook add the same token as a Kaggle Secret named KAGGLE_API_TOKEN.
KAGGLE_API_TOKEN=
