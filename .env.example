# catnip runtime configuration
# Copy to .env and edit. .env is git-ignored.
# All paths are examples — set to whatever your environment exposes.

# === Root of the catnip-data tree ===
# Overrides paths.data in config/pipeline.yaml. All other paths in that
# file are interpolated from this root, so changing this single var
# relocates: source datasets, staging dirs, training sets, models, runs.

# Dev machine (macOS, external SSD)
CATNIP_DATA=/Volumes/rifuSSD/catnip-data

# Dev machine (default, relative to repo root)
# CATNIP_DATA=catnip-data

# Google Colab (gcsfuse-mounted bucket)
# CATNIP_DATA=/content/catnip-data

# Inference server (docker compose / systemd)
# CATNIP_DATA=/srv/catnip-data
