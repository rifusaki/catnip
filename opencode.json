{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gcp-mcp": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "gcp-mcp"
      ]
    },
    "gcp-tools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "gcp-tools-mcp"
      ]
    }
  }
}